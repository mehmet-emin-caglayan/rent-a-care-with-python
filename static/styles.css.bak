/* styles.css */
body {
    font-family: 'Roboto', sans-serif;
    background-color: #f4f4f9;
}

.sidebar {
    width: 250px;
    position: fixed;
    top: 0;
    left: 0;
    background-color: #34495e;
    color: white;
    height: 100%;
    padding-top: 20px;
    padding-left: 20px;
}

.sidebar h2 {
    font-size: 24px;
}

.sidebar ul {
    list-style-type: none;
    padding: 0;
}

.sidebar ul li {
    margin: 15px 0;
}

.sidebar ul li a {
    color: white;
    text-decoration: none;
    font-size: 18px;
}

.content {
    margin-left: 270px;
    padding: 20px;
}

.top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.dashboard-cards {
    display: flex;
    gap: 20px;
}

.card {
    background-color: #fff;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    width: 30%;
}

.card h3 {
    margin-bottom: 15px;
}

.card p {
    font-size: 24px;
    font-weight: bold;
}

.submenu-items {
    display: none;
    list-style: none;
    padding-left: 20px;
}

.submenu:hover .submenu-items {
    display: block;
}